{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acis-context-lab.example/schemas/recording.schema.json",
  "title": "ACIS recording manifest entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["recording_id", "animal_id", "species", "file_uri", "captured_at", "session_id", "site_id", "device_id", "location_class", "consent_status"],
  "properties": {
    "recording_id": {"type": "string", "minLength": 1},
    "animal_id": {"type": "string", "minLength": 1},
    "species": {"type": "string", "minLength": 1},
    "file_uri": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "session_id": {"type": "string", "minLength": 1},
    "site_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "location_class": {"type": "string", "minLength": 1},
    "collector_id": {"type": ["string", "null"]},
    "duration_ms": {"type": ["integer", "null"], "minimum": 1},
    "sample_rate_hz": {"type": ["integer", "null"], "minimum": 1},
    "channels": {"type": ["integer", "null"], "minimum": 1},
    "consent_status": {"type": "string", "minLength": 1}
  }
}
